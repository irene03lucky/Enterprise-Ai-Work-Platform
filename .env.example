# ============================================
# EAI - Enterprise AI Work Platform
# 统一环境变量管理（复制为 .env 使用）
# ============================================

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=eai
POSTGRES_PASSWORD=eai_dev_password
POSTGRES_DB=eai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Backend (FastAPI) ----------
# JWT 密钥，生产环境务必更换
SECRET_KEY=change-me-in-production
# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 允许的前端来源（CORS）
CORS_ORIGINS=http://localhost:3000

# ---------- AI / RAG ----------
# 生成模型提供方：ollama（本地）| openai-compatible（AutoDL 等 OpenAI 兼容端点）
LLM_PROVIDER=ollama
# Ollama 服务地址（容器内通过 host.docker.internal 访问宿主机原生 Ollama）
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 生成模型
LLM_MODEL=qwen2.5:1.5b
# 向量模型（须与 Chroma 已入库向量一致，切换需重建向量库）
EMBEDDING_MODEL=bge-m3
# openai-compatible 模式下的端点与密钥（如 AutoDL）
LLM_BASE_URL=
LLM_API_KEY=

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
