# =============================================================
# EAI 本地运行配置模板
# 用法：cp .env.example .env   然后按下面两种模式二选一填写
# （docker compose 会自动读取项目根目录的 .env）
# =============================================================

# ---------- 数据库 / 基础 ----------
POSTGRES_USER=eai
POSTGRES_PASSWORD=eai_dev_password
POSTGRES_DB=eai
POSTGRES_EXPOSED_PORT=5433
SECRET_KEY=change-me-in-production-please-use-random-32b
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# 时区：容器默认 UTC 会让「今日日程 / 当前时间」等按天计算错位
TZ=Asia/Shanghai
# 主时区：用于「今日日程」等按天计算
APP_TIMEZONE=Asia/Shanghai
# 展示给模型的时区清单（IANA 名称，逗号分隔）——跨境电商 / 多市场团队
# 把业务所在时区都列上，模型即可直接回答「洛杉矶现在几点」而无需用户换算
APP_TIMEZONES=Asia/Shanghai,America/Los_Angeles,America/New_York,Europe/London,Asia/Tokyo,Asia/Singapore,UTC

# =============================================================
# 模式一（推荐：M1/8GB 等内存有限的机器）
# 对话模型走云端 API，本地只跑向量模型 bge-m3
# =============================================================
LLM_PROVIDER=openai-compatible
# 选一个（取消注释并填自己的 Key）：
# —— DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_EXTRA_MODELS=deepseek-chat,deepseek-reasoner
# —— 阿里云百炼（通义千问）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# —— 硅基流动 SiliconFlow（有免费额度）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# —— 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-替换成你的key
LLM_EXTRA_MODELS=

# 向量模型：仍走本机 Ollama（知识库入库/检索必需）
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3

# =============================================================
# 模式二（内存 ≥16GB：全本地，不联网也能用）
# 需要本机已装 Ollama，并 ollama pull 对应模型
# =============================================================
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:7b          # 16GB+；8GB 建议 qwen2.5:3b
# EMBEDDING_MODEL=bge-m3

# Agent 编排：auto（支持 tool-calling 的模型走 ReAct，小模型自动降级 RAG）
AGENT_MODE=auto
